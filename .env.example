# =============================================================================
# Omnix — Environment Variable Template
# =============================================================================
#
# INSTRUCTIONS:
#   1. Copy this file to `.env` in the backend directory:
#        cp .env.example backend/.env
#   2. Fill in your actual values.
#   3. NEVER commit the `.env` file. It is listed in `.gitignore`.
#
# All variables marked [REQUIRED] must be set for the application to start.
# Variables marked [OPTIONAL] have sensible defaults shown here.
#
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Environment name: development | staging | production
APP_ENV=development

# [OPTIONAL] Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# [OPTIONAL] Application version (injected at build time)
APP_VERSION=0.1.0

# [OPTIONAL] Application host and port for the FastAPI server
APP_HOST=127.0.0.1
APP_PORT=8000

# [OPTIONAL] Enable hot-reload in development
APP_RELOAD=true

# [OPTIONAL] CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420


# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Path to the SQLite database file
# Use an absolute path in production.
DATABASE_URL=sqlite:///./data/omnix.db

# [OPTIONAL] Enable SQLAlchemy query echo (for debugging)
DATABASE_ECHO=false


# ─────────────────────────────────────────────────────────────────────────────
# VECTOR STORE (FAISS)
# ─────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Directory to persist FAISS indexes
FAISS_INDEX_PATH=./data/faiss_indexes

# [OPTIONAL] Embedding dimension (must match your embedding model)
EMBEDDING_DIM=1536


# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDERS — CLOUD
# Leave blank if not using a particular provider.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-pro

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022


# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDERS — LOCAL (OLLAMA)
# ─────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Ollama server base URL
OLLAMA_BASE_URL=http://localhost:11434

# [OPTIONAL] Default local model to use
OLLAMA_DEFAULT_MODEL=llama3.2


# ─────────────────────────────────────────────────────────────────────────────
# ACTIVE AI PROVIDER
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Which provider to use: openai | gemini | anthropic | ollama
AI_PROVIDER=ollama

# [OPTIONAL] Which provider to use for embeddings: openai | ollama
EMBEDDING_PROVIDER=ollama

# [OPTIONAL] Embedding model override (provider-specific)
EMBEDDING_MODEL=nomic-embed-text


# ─────────────────────────────────────────────────────────────────────────────
# FILE INDEXING
# ─────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Root directories to index (comma-separated absolute paths)
INDEX_PATHS=~/Documents,~/Desktop,~/Projects

# [OPTIONAL] File extensions to include in indexing (comma-separated)
INDEX_EXTENSIONS=.txt,.md,.pdf,.docx,.py,.ts,.tsx,.js,.rs,.json,.csv

# [OPTIONAL] Directories to exclude from indexing (comma-separated)
INDEX_EXCLUDE_DIRS=node_modules,.git,__pycache__,.venv,dist,build,target

# [OPTIONAL] Maximum file size to index in MB
INDEX_MAX_FILE_SIZE_MB=50

# [OPTIONAL] Indexing interval in seconds (for background watcher)
INDEX_INTERVAL_SECONDS=300


# ─────────────────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED in production] Secret key for signing tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-generate-a-real-secret-key

# [OPTIONAL] Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=10080


# ─────────────────────────────────────────────────────────────────────────────
# TAURI / FRONTEND
# ─────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Dev server port for Vite (must match Tauri config)
VITE_DEV_PORT=1420

# [OPTIONAL] Backend API base URL (used by frontend services)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1


# ─────────────────────────────────────────────────────────────────────────────
# TELEMETRY (future)
# ─────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Enable anonymous crash reporting (opt-in, false by default)
TELEMETRY_ENABLED=false
