# EditorConfig — https://editorconfig.org
# Omnix Project — Universal coding style enforcement
# Supported by VS Code, JetBrains, Vim, Neovim, Sublime Text, and more.

root = true

# ── Defaults (all files) ─────────────────────────────────────────────────────
[*]
charset                  = utf-8
end_of_line              = lf
indent_style             = space
indent_size              = 2
tab_width                = 2
trim_trailing_whitespace = true
insert_final_newline     = true
max_line_length          = 100

# ── Python ───────────────────────────────────────────────────────────────────
[*.py]
indent_size    = 4
max_line_length = 88

# ── TypeScript / JavaScript / TSX / JSX ──────────────────────────────────────
[*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}]
indent_size    = 2
max_line_length = 100

# ── Rust (Tauri backend shell) ────────────────────────────────────────────────
[*.rs]
indent_size    = 4
max_line_length = 100

# ── JSON ──────────────────────────────────────────────────────────────────────
[*.json]
indent_size = 2

# ── TOML ──────────────────────────────────────────────────────────────────────
[*.toml]
indent_size = 2

# ── YAML ──────────────────────────────────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

# ── Markdown ──────────────────────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false
max_line_length          = off

# ── CSS / SCSS ────────────────────────────────────────────────────────────────
[*.{css,scss,sass}]
indent_size = 2

# ── HTML ──────────────────────────────────────────────────────────────────────
[*.html]
indent_size = 2

# ── Shell scripts ─────────────────────────────────────────────────────────────
[*.{sh,bash,zsh}]
indent_style = space
indent_size  = 2

# ── Makefiles (must use tabs) ─────────────────────────────────────────────────
[Makefile]
indent_style = tab

# ── Git commit messages ───────────────────────────────────────────────────────
[COMMIT_EDITMSG]
max_line_length = 72
