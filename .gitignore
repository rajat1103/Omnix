# =============================================================================
# Omnix — .gitignore
# Covers: Python, Node.js, Rust (Tauri), editors, OS files
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
*.spec
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version

# Distribution / packaging
.eggs/
*.egg-info/
pip-wheel-metadata/

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytest.ini

# Jupyter Notebooks
.ipynb_checkpoints

# pyenv
.python-version

# Celery
celerybeat-schedule
celerybeat.pid

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre
.pyre/

# pytype
.pytype/

# Ruff
.ruff_cache/

# -----------------------------------------------------------------------------
# Node.js / Frontend
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.npm
.yarn-integrity

# Build outputs
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/

# Vite
frontend/.vite/

# TypeScript
*.tsbuildinfo

# ESLint
.eslintcache

# Prettier
.prettiercache

# -----------------------------------------------------------------------------
# Tauri / Rust
# -----------------------------------------------------------------------------
frontend/src-tauri/target/
frontend/src-tauri/WixTools/

# -----------------------------------------------------------------------------
# Environment & Secrets
# -----------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
secrets/
*.key
*.cert

# API keys and configs (never commit)
backend/.env
backend/config/local.yaml
frontend/.env.local

# -----------------------------------------------------------------------------
# Database & Storage
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# FAISS indexes
*.faiss
*.index
data/

# -----------------------------------------------------------------------------
# AI / ML
# -----------------------------------------------------------------------------
models/
*.gguf
*.ggml
*.bin
embeddings_cache/

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
logs/
*.log
*.log.*
log/

# -----------------------------------------------------------------------------
# OS & Editor Files
# -----------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# VS Code
.vscode/
*.code-workspace
.history/

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws
.idea_modules/

# Vim
*.swp
*.swo
*~

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
*.bak
*.tmp
*.temp
.cache/
tmp/
temp/
